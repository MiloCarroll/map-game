node_modules/
# Flag SVGs are copied from the flag-icons package by `npm run flags`.
app/public/flags/
# Raw NE sources are large and re-downloadable via `npm run data:download`.
data/raw/
# Intermediate slimmed layers (regenerated by `npm run data:tiles`).
data/build/
# Built app output (GitHub Actions rebuilds it for Pages).
app/dist/
# data/dist/ IS committed: the deployed app serves it (tippecanoe isn't run in CI).
.DS_Store
